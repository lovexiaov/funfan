<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  打包进 FunFan.app/Contents/Library/LaunchDaemons/ 的守护进程描述，
	  供 SMAppService.daemon(plistName:) 注册（macOS 13+ 的一次授权安装）。

	  与 scripts/install-helper.sh 里那份「开发期直装 plist」的区别：
	  · 这里用 BundleProgram（相对 App 包内的可执行文件），
	    直装版用 ProgramArguments（绝对路径 /Library/PrivilegedHelperTools/...）。
	    SMAppService 只认 BundleProgram —— 因为它要求可执行文件必须在签名后的
	    App 包内，这样系统才能把 helper 的签名信任链绑到 App 上。
	  · 不带 EnvironmentVariables：签名校验要求不再靠环境变量开关，
	    helper 会自己从签名里取 Team ID 生成客户端要求。
	-->
	<key>Label</key>
	<string>com.funfan.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/FunFanHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.funfan.helper</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<!-- 让「登录项与扩展」里能把这条后台项归到 FunFan 名下，卸载 App 时一起清掉 -->
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.funfan.app</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/var/log/com.funfan.helper.log</string>
</dict>
</plist>
